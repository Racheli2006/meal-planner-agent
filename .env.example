# Copy this file to a file named .env (in the same folder) and put your own key in it.
# The .env file is never uploaded to GitHub (see .gitignore).
# Get a key at https://platform.openai.com/api-keys
#
# Instead of a .env file you can also set the OPENAI_API_KEY environment variable;
# if both exist, the environment variable wins.
OPENAI_API_KEY=sk-your-key-here
